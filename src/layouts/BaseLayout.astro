---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { afterYouReturnTabs, beforeYouGoTabs, topNav } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Virtual Rocky Shore Sampling Unit',
  description = 'TIDE Virtual Rocky Shore Sampling Unit (VRSSU) — educational tools for intertidal sampling and abundance estimation.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const basePath = base.endsWith('/') ? base : `${base}/`;

function hrefFor(path: string) {
  if (path === '/') return basePath;
  return `${basePath}${path.replace(/^\/+/, '')}`;
}

function normalizePath(path: string) {
  const pathname = path.split(/[?#]/, 1)[0] || '/';
  const withLeadingSlash = pathname.startsWith('/') ? pathname : `/${pathname}`;
  return withLeadingSlash.replace(/\/+$/, '') || '/';
}

const navigationGroups: Record<string, readonly string[]> = {
  '/': ['/'],
  '/dashboard': ['/dashboard', '/students/introStudent'],
  '/students/beforeUgo': ['/students/beforeUgo', ...beforeYouGoTabs.map((tab) => tab.href)],
  '/students/afterUreturn': afterYouReturnTabs.map((tab) => tab.href),
  '/students/resources': ['/students/resources'],
};

function navMatchesFor(href: string) {
  return navigationGroups[href] ?? [href];
}

function isNavActive(href: string) {
  const path = normalizePath(currentPath);
  return navMatchesFor(href).some((route) => normalizePath(hrefFor(route)) === path);
}

function navCurrentValue(href: string) {
  if (!isNavActive(href)) return undefined;
  return normalizePath(hrefFor(href)) === normalizePath(currentPath) ? 'page' : 'location';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d373c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/x-icon" href={`${basePath}favicon.ico`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header
      class="site-header sticky top-0 z-40 border-b border-tide-900/10 bg-white/92 backdrop-blur-xl"
      transition:persist="site-header"
    >
      <div class="mx-auto flex min-h-18 max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a
          href={basePath}
          class="group flex min-w-0 items-center gap-3 no-underline hover:no-underline"
          aria-label="Virtual Rocky Shore Sampling Unit home"
        >
          <img
            src={`${basePath}SWIMSlogo2_transbg.png`}
            alt="SWIMS logo"
            class="h-9 w-auto shrink-0 transition-transform group-hover:scale-[1.02] sm:h-11"
            width="120"
            height="40"
          />
          <div class="min-w-0 leading-tight">
            <p class="truncate font-display text-sm font-semibold text-tide-950 sm:text-lg">
              Virtual Rocky Shore Sampling Unit
            </p>
            <p class="mt-0.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-tide-600 sm:text-xs">
              Coastal field guide · TIDE HKU
            </p>
          </div>
        </a>

        <nav class="hidden items-center gap-2 lg:flex" aria-label="Primary">
          <ul class="flex items-center gap-0.5">
            {
              topNav.map((item) => (
                <li>
                  <a
                    href={hrefFor(item.href)}
                    class:list={['primary-nav-link', isNavActive(item.href) && 'is-active']}
                    aria-current={navCurrentValue(item.href)}
                    data-nav-matches={navMatchesFor(item.href).map(hrefFor).join('|')}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <slot name="header-actions" />
        </nav>

        <details id="mobile-nav" class="group relative shrink-0 lg:hidden">
          <summary
            class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-tide-900/15 bg-white px-3 py-2 text-sm font-semibold text-tide-900 shadow-sm marker:content-none group-open:border-tide-600 group-open:bg-tide-50 [&::-webkit-details-marker]:hidden"
            aria-label="Open site navigation"
            aria-controls="mobile-nav-panel"
            aria-expanded="false"
          >
            <svg
              class="h-5 w-5 group-open:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              class="hidden h-5 w-5 group-open:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
            </svg>
            <span>Menu</span>
          </summary>
          <nav
            id="mobile-nav-panel"
            class="mobile-menu-panel absolute right-0 z-50 mt-2 w-[min(20rem,calc(100vw-2rem))] rounded-xl border border-tide-900/10 bg-white p-2.5"
            aria-label="Mobile primary"
          >
            <p class="px-3 pb-2 pt-1 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-tide-600">
              Explore the field guide
            </p>
            <ul class="space-y-1">
              {
                topNav.map((item) => (
                  <li>
                    <a
                      href={hrefFor(item.href)}
                      class:list={['mobile-nav-link', isNavActive(item.href) && 'is-active']}
                      aria-current={navCurrentValue(item.href)}
                      data-nav-matches={navMatchesFor(item.href).map(hrefFor).join('|')}
                    >
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" class="flex-1" tabindex="-1" transition:animate="fade">
      <slot />
    </main>

    <footer class="mt-auto border-t-4 border-tide-600 bg-tide-950 text-tide-100">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-8 text-sm text-tide-100/80 sm:flex-row sm:items-end sm:justify-between sm:px-6">
        <div>
          <p class="font-medium text-tide-100">
            VRSSU · TIDE group · School of Biological Sciences · The University of Hong Kong
          </p>
          <p class="mt-1.5 text-xs text-tide-100/55">
            Field guide rebuild · based on VRSSU teaching materials
          </p>
        </div>
        <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Footer">
          <a
            href={hrefFor('/students/resources')}
            class="text-tide-100/80 no-underline hover:text-white hover:underline"
          >
            Resources
          </a>
          <a
            href={hrefFor('/students/acknowledgement')}
            class="text-tide-100/80 no-underline hover:text-white hover:underline"
          >
            Acknowledgements
          </a>
        </nav>
      </div>
    </footer>

    <script>
      function normalizeBrowserPath(path: string) {
        const pathname = path.split(/[?#]/, 1)[0] || '/';
        const withLeadingSlash = pathname.startsWith('/') ? pathname : `/${pathname}`;
        return withLeadingSlash.replace(/\/+$/, '') || '/';
      }

      function syncMobileNavState(details: HTMLDetailsElement) {
        const summary = details.querySelector('summary');
        if (!(summary instanceof HTMLElement)) return;
        summary.setAttribute('aria-expanded', String(details.open));
        summary.setAttribute(
          'aria-label',
          details.open ? 'Close site navigation' : 'Open site navigation',
        );
      }

      function closeMobileNav({ restoreFocus = false } = {}) {
        const details = document.getElementById('mobile-nav');
        if (!(details instanceof HTMLDetailsElement)) return;
        details.open = false;
        if (restoreFocus) details.querySelector('summary')?.focus();
      }

      function bindMobileNav() {
        const details = document.getElementById('mobile-nav');
        if (!(details instanceof HTMLDetailsElement)) return;

        if (details.dataset.toggleBound !== 'true') {
          details.dataset.toggleBound = 'true';
          details.addEventListener('toggle', () => syncMobileNavState(details));
        }
        syncMobileNavState(details);

        if (document.documentElement.dataset.siteNavEventsBound === 'true') return;
        document.documentElement.dataset.siteNavEventsBound = 'true';

        document.addEventListener('click', (event) => {
          const activeDetails = document.getElementById('mobile-nav');
          if (!(activeDetails instanceof HTMLDetailsElement) || !activeDetails.open) return;
          if (!(event.target instanceof Element)) return;

          if (event.target.closest('#mobile-nav a')) {
            closeMobileNav();
          } else if (!activeDetails.contains(event.target)) {
            closeMobileNav();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          const activeDetails = document.getElementById('mobile-nav');
          if (activeDetails instanceof HTMLDetailsElement && activeDetails.open) {
            event.preventDefault();
            closeMobileNav({ restoreFocus: true });
          }
        });
      }

      function syncNavActive() {
        const path = normalizeBrowserPath(window.location.pathname);
        document.querySelectorAll('header a[data-nav-matches]').forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;

          const matches = (link.dataset.navMatches ?? '')
            .split('|')
            .filter(Boolean)
            .map((match) => normalizeBrowserPath(new URL(match, window.location.origin).pathname));
          const active = matches.includes(path);
          link.classList.toggle('is-active', active);

          if (active) {
            const exact = normalizeBrowserPath(link.pathname) === path;
            link.setAttribute('aria-current', exact ? 'page' : 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }

      function revealActiveSectionTab() {
        document.querySelectorAll('[data-section-tab-scroller]').forEach((element) => {
          if (!(element instanceof HTMLElement) || element.scrollWidth <= element.clientWidth) {
            return;
          }
          const active = element.querySelector('[aria-current="page"]');
          if (!(active instanceof HTMLElement)) return;
          const left = active.offsetLeft - (element.clientWidth - active.offsetWidth) / 2;
          element.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
        });
      }

      function onPageLoad() {
        bindMobileNav();
        syncNavActive();
        requestAnimationFrame(revealActiveSectionTab);
      }

      onPageLoad();
      document.addEventListener('astro:page-load', onPageLoad);
    </script>
  </body>
</html>
