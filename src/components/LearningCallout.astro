---
type Variant = 'objective' | 'field-note' | 'safety' | 'key-concept';

interface Props {
  id: string;
  title: string;
  variant: Variant;
}

const { id, title, variant } = Astro.props;

const configurations: Record<
  Variant,
  { label: string; panelClass: string; iconClass: string; labelClass: string }
> = {
  objective: {
    label: 'Learning objective',
    panelClass: 'border-tide-600/30 bg-tide-50',
    iconClass: 'bg-tide-700 text-white',
    labelClass: 'text-tide-700',
  },
  'field-note': {
    label: 'Field note',
    panelClass: 'border-kelp/30 bg-white',
    iconClass: 'bg-kelp text-white',
    labelClass: 'text-kelp',
  },
  safety: {
    label: 'Safety',
    panelClass: 'border-coral/35 bg-sand-100/70',
    iconClass: 'bg-coral text-white',
    labelClass: 'text-coral',
  },
  'key-concept': {
    label: 'Key concept',
    panelClass: 'border-tide-900/15 bg-white',
    iconClass: 'bg-tide-100 text-tide-900',
    labelClass: 'text-tide-700',
  },
};

const config = configurations[variant];
---

<aside
  class:list={[
    'rounded-2xl border p-5 shadow-[0_1px_2px_rgb(8_38_42_/_0.05)] md:p-6',
    config.panelClass,
  ]}
  aria-labelledby={id}
>
  <div class="flex items-start gap-4">
    <span
      class:list={[
        'flex h-10 w-10 shrink-0 items-center justify-center rounded-full',
        config.iconClass,
      ]}
      aria-hidden="true"
    >
      {
        variant === 'objective' && (
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="8"></circle>
            <circle cx="12" cy="12" r="3"></circle>
            <path stroke-linecap="round" d="M12 4V2m8 10h2M12 20v2M4 12H2"></path>
          </svg>
        )
      }
      {
        variant === 'field-note' && (
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 3.5h9l3 3V20.5H6z"></path>
            <path stroke-linecap="round" d="M9 10h6m-6 4h6"></path>
          </svg>
        )
      }
      {
        variant === 'safety' && (
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4z"></path>
            <path stroke-linecap="round" d="M12 9v5m0 3h.01"></path>
          </svg>
        )
      }
      {
        variant === 'key-concept' && (
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 15.5a6 6 0 1 1 7 0c-.9.7-1.3 1.5-1.3 2.5H9.8c0-1-.4-1.8-1.3-2.5Z"></path>
            <path stroke-linecap="round" d="M10 21h4"></path>
          </svg>
        )
      }
    </span>

    <div class="min-w-0">
      <p class:list={['text-xs font-bold uppercase tracking-[0.13em]', config.labelClass]}>
        {config.label}
      </p>
      <h2 id={id} class="mt-1 font-display text-xl font-semibold leading-tight text-tide-950 md:text-2xl">
        {title}
      </h2>
      <div class="mt-2 text-sm leading-relaxed text-ink/85 md:text-base">
        <slot />
      </div>
    </div>
  </div>
</aside>
