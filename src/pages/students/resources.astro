---
import StudentsLayout from '../../layouts/StudentsLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resources } from '../../data/copy';

const base = import.meta.env.BASE_URL;
---

<StudentsLayout title="VRSSU · Resources" wide>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Resources' },
    ]}
  />
  <h1 class="page-title mb-3">Resources</h1>
  <p class="mb-10 text-base text-muted md:text-lg">
    Tide tools, species references, and further reading for Hong Kong and beyond.
  </p>

  <div class="space-y-12 md:grid md:grid-cols-2 md:gap-12 md:space-y-0">
    <section>
      <h2 class="section-title mb-4 text-xl md:text-2xl">Hong Kong shores</h2>
      <div class="prose-edu" set:html={resources.localInfo} />
    </section>
    <section>
      <h2 class="section-title mb-4 text-xl md:text-2xl">General resources</h2>
      <div class="prose-edu" set:html={resources.generalInfo} />
    </section>
  </div>

  <p class="mt-12 text-base text-muted md:text-lg">
    Also see
    <a href={`${base}students/acknowledgement`}>Acknowledgements</a>
    for contributors and funding.
  </p>
</StudentsLayout>
