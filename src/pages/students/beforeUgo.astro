---
import { Image } from 'astro:assets';
import StudentsLayout from '../../layouts/StudentsLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import physicalImage from '../../assets/beforeUgo/Before you go (1).png';
import prepareImage from '../../assets/beforeUgo/Before you go (2).png';
import protocolImage from '../../assets/beforeUgo/Before you go (3).png';
import speciesImage from '../../assets/beforeUgo/Before you go (4).png';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

function hrefFor(path: string) {
  return `${basePath}${path.replace(/^\/+/, '')}`;
}

const topics = [
  {
    id: 'environment',
    href: '/students/physicalEnv',
    label: 'Physical environment',
    stage: 'Read the shore',
    effort: '8–10 min',
    blurb: 'Use tides, tidal height, and wave exposure to explain changing conditions across a rocky shore.',
    objective: 'Relate shore conditions to both species patterns and safe survey timing.',
    action: 'Study the shore environment',
    image: physicalImage,
    imageAlt: 'Exposed rock platform beside the sea',
  },
  {
    id: 'preparation',
    href: '/students/materials',
    label: 'What to prepare',
    stage: 'Pack and plan',
    effort: '6–8 min',
    blurb: 'Check safety precautions, survey equipment, personal kit, weather, and tidal timing.',
    objective: 'Build a practical checklist and know when conditions mean the survey should stop.',
    action: 'Review the field checklist',
    image: prepareImage,
    imageAlt: 'Protective clothing and field equipment arranged for a shore survey',
  },
  {
    id: 'protocol',
    href: '/students/samplingProtocol',
    label: 'Sampling protocol',
    stage: 'Standardise the method',
    effort: '12–15 min',
    blurb: 'Set tidal heights and transects, randomise quadrat locations, and apply consistent counting rules.',
    objective: 'Describe a repeatable transect-and-quadrat protocol that reduces placement and counting bias.',
    action: 'Learn the survey protocol',
    image: protocolImage,
    imageAlt: 'Researcher identifying organisms within a quadrat',
  },
  {
    id: 'species',
    href: '/students/commonSpecies',
    label: 'Common species',
    stage: 'Practise identification',
    effort: '8–12 min',
    blurb: 'Browse common Hong Kong rocky-shore animals, algae, and cyanobacteria before recording counts.',
    objective: 'Recognise the guide groups and use scientific names consistently on the data sheet.',
    action: 'Open the species guide',
    image: speciesImage,
    imageAlt: 'Chitons, mussels, and other organisms on a rocky shore',
  },
];
---

<StudentsLayout title="VRSSU · Before you go" wide>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Before you go' },
    ]}
  />

  <header class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.15em] text-tide-600">
        Field guide · Stop 2 of 4
      </p>
      <h1 class="page-title mt-2">Before you go: prepare a repeatable survey</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
        Read the conditions first, make safety decisions, standardise the method, and agree on
        species names before anyone starts counting.
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-sm font-semibold text-tide-900">
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          Estimated reading: 35–45 min
        </span>
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          4 field notes
        </span>
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          Fieldwork time not included
        </span>
      </div>
    </div>

    <aside class="panel p-5 md:p-6" aria-label="Learning objectives">
      <p class="text-xs font-bold uppercase tracking-[0.13em] text-tide-600">
        Learning objectives
      </p>
      <ul class="mt-3 space-y-3 text-sm leading-relaxed text-ink/85">
        <li class="flex gap-2">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide-500" aria-hidden="true"></span>
          <span>Connect environmental gradients to survey design and safety.</span>
        </li>
        <li class="flex gap-2">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide-500" aria-hidden="true"></span>
          <span>Prepare the equipment and roles needed for consistent fieldwork.</span>
        </li>
        <li class="flex gap-2">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tide-500" aria-hidden="true"></span>
          <span>Explain how random placement and counting rules reduce bias.</span>
        </li>
      </ul>
      <a
        class="btn-primary mt-5 w-full"
        href={hrefFor(topics[0].href)}
        data-topic-link
        data-topic-id={topics[0].id}
        data-continue-link
      >
        Start with the environment
      </a>
    </aside>
  </header>

  <nav class="mt-10 rounded-xl border border-tide-900/10 bg-tide-950 px-5 py-4 text-sm text-white" aria-label="Learning journey">
    <ol class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <li>
        <a class="font-semibold text-tide-200 no-underline hover:text-white" href={hrefFor('/students/introStudent')}>
          Theory
        </a>
      </li>
      <li class="text-tide-400" aria-hidden="true">→</li>
      <li class="font-semibold text-white" aria-current="step">Field preparation</li>
      <li class="text-tide-400" aria-hidden="true">→</li>
      <li>
        <a class="font-semibold text-tide-200 no-underline hover:text-white" href={hrefFor('/students/afterUreturn')}>
          Survey data
        </a>
      </li>
      <li class="text-tide-400" aria-hidden="true">→</li>
      <li>
        <a class="font-semibold text-tide-200 no-underline hover:text-white" href={hrefFor('/students/wtcanweLearn')}>
          Synthesis
        </a>
      </li>
    </ol>
  </nav>

  <section class="mt-12" aria-labelledby="field-notes-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-tide-600">
          Recommended order
        </p>
        <h2 id="field-notes-heading" class="section-title mt-1">Four notes to take into the field</h2>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <p class="max-w-md text-sm text-muted">
          Opened status stays in this browser and does not imply completion.
        </p>
        <button class="btn-ghost text-sm" type="button" data-clear-topic-progress>
          Clear opened status
        </button>
      </div>
    </div>

    <ol class="mt-7 grid gap-6 sm:grid-cols-2">
      {
        topics.map((topic, i) => (
          <li>
            <article
              class="group h-full overflow-hidden rounded-2xl border border-tide-900/10 bg-white shadow-[0_1px_2px_rgb(8_38_42_/_0.05),0_12px_32px_rgb(8_38_42_/_0.07)]"
              data-topic-card
              data-topic-id={topic.id}
              data-topic-title={topic.label}
              data-topic-href={hrefFor(topic.href)}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-tide-100">
                <Image
                  src={topic.image}
                  alt={topic.imageAlt}
                  widths={[400, 640, 800]}
                  sizes="(max-width: 640px) 100vw, 32rem"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                />
                <span class="absolute left-4 top-4 rounded-full bg-tide-950/90 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white">
                  Note {i + 1} of {topics.length}
                </span>
              </div>

              <div class="p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-xs font-bold uppercase tracking-[0.13em] text-tide-600">
                    {topic.stage}
                  </p>
                  <p class="flex items-center gap-2 text-xs font-semibold text-muted">
                    <span>{topic.effort}</span>
                    <span aria-hidden="true">·</span>
                    <span class="inline-flex items-center gap-1.5" aria-live="polite">
                      <span class="h-2 w-2 rounded-full bg-tide-300" aria-hidden="true"></span>
                      <span data-topic-status>Ready</span>
                    </span>
                  </p>
                </div>

                <h3 class="mt-2 font-display text-2xl font-semibold text-tide-950 md:text-3xl">
                  <a
                    href={hrefFor(topic.href)}
                    class="text-tide-950 no-underline hover:text-tide-700 hover:underline"
                    data-topic-link
                    data-topic-id={topic.id}
                  >
                    {topic.label}
                  </a>
                </h3>
                <p class="mt-3 text-base leading-relaxed text-ink/85">{topic.blurb}</p>

                <div class="mt-5 rounded-xl bg-tide-50 px-4 py-3 text-sm leading-relaxed text-ink/85">
                  <span class="font-semibold text-tide-900">Field-note objective:</span>
                  {` ${topic.objective}`}
                </div>

                <a
                  class="btn-secondary mt-5"
                  href={hrefFor(topic.href)}
                  data-topic-link
                  data-topic-id={topic.id}
                >
                  {topic.action}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <aside class="mt-10 rounded-2xl border border-tide-900/10 bg-sand-100/70 p-6 md:flex md:items-center md:justify-between md:gap-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-tide-600">When the survey is done</p>
      <h2 class="mt-1 font-display text-2xl font-semibold text-tide-950">
        Turn field counts into evidence
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
        The next guide connects your quadrat counts to descriptive statistics, sample-data
        exploration, spreadsheet upload, and a careful synthesis.
      </p>
    </div>
    <a class="btn-primary mt-5 shrink-0 md:mt-0" href={hrefFor('/students/afterUreturn')}>
      Continue to after you return
      <span aria-hidden="true">→</span>
    </a>
  </aside>

  <script>
    const journeyProgressKey = 'vrssu-journey-opened-v1';
    const topicProgressKey = 'vrssu-before-opened-v1';
    const topicCards = Array.from(document.querySelectorAll<HTMLElement>('[data-topic-card]'));
    const continueLink = document.querySelector<HTMLAnchorElement>('[data-continue-link]');

    type OpenedProgress = { opened: string[]; last?: string };

    function readProgress(key: string): OpenedProgress {
      try {
        const saved = JSON.parse(localStorage.getItem(key) || '{}') as OpenedProgress;
        return {
          opened: Array.isArray(saved.opened) ? saved.opened : [],
          last: typeof saved.last === 'string' ? saved.last : undefined,
        };
      } catch {
        return { opened: [] };
      }
    }

    function writeProgress(key: string, progress: OpenedProgress) {
      try {
        localStorage.setItem(key, JSON.stringify(progress));
      } catch {
        // The guide remains fully usable when browser storage is unavailable.
      }
    }

    function markJourneySectionOpened() {
      const progress = readProgress(journeyProgressKey);
      if (!progress.opened.includes('before')) progress.opened.push('before');
      progress.last = 'before';
      writeProgress(journeyProgressKey, progress);
    }

    function renderTopicProgress() {
      const progress = readProgress(topicProgressKey);
      topicCards.forEach((card) => {
        const id = card.dataset.topicId || '';
        const status = card.querySelector<HTMLElement>('[data-topic-status]');
        const dot = status?.previousElementSibling;
        const wasOpened = progress.opened.includes(id);
        if (status) status.textContent = wasOpened ? 'Opened' : 'Ready';
        dot?.classList.toggle('bg-tide-300', !wasOpened);
        dot?.classList.toggle('bg-kelp', wasOpened);
      });

      const lastCard = topicCards.find((card) => card.dataset.topicId === progress.last);
      if (lastCard && continueLink) {
        continueLink.href = lastCard.dataset.topicHref || continueLink.href;
        continueLink.textContent = `Continue ${lastCard.dataset.topicTitle || 'field preparation'} →`;
      }
    }

    document.querySelectorAll<HTMLElement>('[data-topic-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.topicId;
        if (!id) return;
        const progress = readProgress(topicProgressKey);
        if (!progress.opened.includes(id)) progress.opened.push(id);
        progress.last = id;
        writeProgress(topicProgressKey, progress);
      });
    });

    document
      .querySelector<HTMLElement>('[data-clear-topic-progress]')
      ?.addEventListener('click', () => {
        try {
          localStorage.removeItem(topicProgressKey);
        } catch {
          // Nothing to clear when browser storage is unavailable.
        }
        renderTopicProgress();
      });

    markJourneySectionOpened();
    renderTopicProgress();
  </script>
</StudentsLayout>
