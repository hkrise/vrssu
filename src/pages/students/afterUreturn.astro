---
import { Image } from 'astro:assets';
import StudentsLayout from '../../layouts/StudentsLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SubNav from '../../components/SubNav.astro';
import SelfCheck from '../../components/vue/SelfCheck.vue';
import Stepper from '../../components/vue/Stepper.vue';
import { afterYouReturnTabs } from '../../data/nav';
import { afterTheory } from '../../data/copy';
import img1 from '../../assets/afterUback/After you return2-04.png';
import img2 from '../../assets/afterUback/After you return2-05.png';
import img3 from '../../assets/afterUback/After you return2-06.png';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

function hrefFor(path: string) {
  return `${basePath}${path.replace(/^\/+/, '')}`;
}

const steps = [
  {
    title: 'From field notes to data',
    html: `<p>${afterTheory.textPrefix}</p>`,
    images: [
      { src: img1.src, alt: 'Field notes to spreadsheet' },
      { src: img2.src, alt: 'Organising survey counts' },
      { src: img3.src, alt: 'Summarising abundance data' },
    ],
  },
  {
    title: 'Descriptive statistics for abundance',
    html: `
      <p>${afterTheory.p1}</p>
      <table class="my-4 w-full max-w-md border-collapse text-base">
        <caption class="caption mb-2 text-left">Worked example: counts from four replicate quadrats.</caption>
        <thead>
          <tr class="bg-tide-50">
            <th scope="col" class="border px-3 py-2">Quadrat</th>
            <th scope="col" class="border px-3 py-2">Count</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row" class="border px-3 py-2 font-medium">Q1</th><td class="border px-3 py-2">0</td></tr>
          <tr><th scope="row" class="border px-3 py-2 font-medium">Q2</th><td class="border px-3 py-2">5</td></tr>
          <tr><th scope="row" class="border px-3 py-2 font-medium">Q3</th><td class="border px-3 py-2">2</td></tr>
          <tr><th scope="row" class="border px-3 py-2 font-medium">Q4</th><td class="border px-3 py-2">10</td></tr>
        </tbody>
      </table>
      <p>${afterTheory.p2}</p>
      <p>${afterTheory.p3}</p>
    `,
  },
  {
    title: 'Why sample size matters',
    html: `<p>${afterTheory.p4}</p>`,
  },
];

const analysisRoute = [
  {
    id: 'theory',
    number: '01',
    title: 'Background theory',
    href: '/students/afterUreturn',
    effort: '6–8 min',
    description: 'Connect field counts to mean, SD, SE, and sampling effort.',
    action: 'Read the theory below',
    initialStatus: 'Current page',
  },
  {
    id: 'sample',
    number: '02',
    title: 'Explore sample data',
    href: '/students/samplingEffortTaiTam',
    effort: '8–10 min',
    description: 'Use the Tai Tam dataset to see how estimates change as quadrats are added.',
    action: 'Open the sample dataset',
    initialStatus: 'Next',
  },
  {
    id: 'upload',
    number: '03',
    title: 'Plot your survey',
    href: '/students/dataAnalysis',
    effort: '5–8 min',
    description: 'Download the template and upload an .xlsx file; processing stays in your browser.',
    action: 'Use your spreadsheet',
    initialStatus: 'Then',
  },
  {
    id: 'synthesis',
    number: '04',
    title: 'Synthesis',
    href: '/students/wtcanweLearn',
    effort: '5–7 min',
    description: 'Decide what the graph supports—and what it cannot prove about the shore.',
    action: 'Interpret the evidence',
    initialStatus: 'Finish',
  },
];

const spreadAndPrecisionOptions = [
  {
    label:
      'SD describes how quadrat counts vary around the mean; SE describes uncertainty in the estimated mean and often becomes smaller as more quadrats are sampled.',
    correct: true,
    feedback:
      'SD summarises spread among observations. SE is calculated from SD and sample size (SD / √n), so it reflects the precision of the sample mean.',
  },
  {
    label:
      'SE describes how different individual quadrats are; SD describes how certain the estimated mean is.',
    correct: false,
    feedback:
      'The roles are reversed here: SD describes spread among quadrat counts, while SE describes uncertainty in the mean estimate.',
  },
  {
    label:
      'SD and SE are interchangeable names for the same quantity, so either can be used without stating which one was calculated.',
    correct: false,
    feedback:
      'They answer different questions. A result should identify which measure is shown so readers know whether it represents spread or precision.',
  },
];
---

<StudentsLayout title="VRSSU · After you return" wide>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'After you return' },
    ]}
  />
  <SubNav tabs={afterYouReturnTabs} />

  <header class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_25rem] lg:items-center">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.15em] text-tide-600">
        Field guide · Stop 3 of 4
      </p>
      <h1 class="page-title mt-2">After you return: turn counts into evidence</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
        Begin with the statistical ideas, practise on a real sample dataset, repeat the workflow
        with your own spreadsheet, then write a cautious synthesis.
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-sm font-semibold text-tide-900">
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          Core route: about 25–35 min
        </span>
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          4 connected stops
        </span>
        <span class="rounded-full border border-tide-900/10 bg-white px-3 py-1.5">
          No sign-in or data submission
        </span>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn-primary" href="#theory">
          Start with background theory
          <span aria-hidden="true">↓</span>
        </a>
        <a class="btn-secondary" href={hrefFor('/students/samplingEffortTaiTam')}>
          Already know the theory? Use sample data
        </a>
      </div>
    </div>

    <figure class="edu-figure">
      <Image
        src={img2}
        alt="Transect tape following a tidal height across a rocky shore"
        widths={[480, 720, 960]}
        sizes="(max-width: 1024px) 100vw, 25rem"
        class="aspect-[4/3] w-full object-cover shadow-md"
      />
      <figcaption class="caption mt-3">
        The analysis only makes sense when the field method and sampling units are understood.
      </figcaption>
    </figure>
  </header>

  <aside class="panel mt-10 p-5 md:p-6" aria-labelledby="objectives-heading">
    <div class="grid gap-5 md:grid-cols-[14rem_minmax(0,1fr)] md:items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.13em] text-tide-600">Learning objectives</p>
        <h2 id="objectives-heading" class="mt-1 font-display text-2xl font-semibold text-tide-950">
          Follow the data story
        </h2>
      </div>
      <ul class="grid gap-3 text-sm leading-relaxed text-ink/85 sm:grid-cols-3">
        <li class="rounded-xl bg-tide-50 px-4 py-3">
          Explain what mean, SD, and SE contribute to an abundance summary.
        </li>
        <li class="rounded-xl bg-tide-50 px-4 py-3">
          Judge how stable an estimate looks as sampling effort increases.
        </li>
        <li class="rounded-xl bg-tide-50 px-4 py-3">
          State a conclusion without claiming that a sample reveals the whole shore.
        </li>
      </ul>
    </div>
  </aside>

  <section class="mt-12" aria-labelledby="analysis-route-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-tide-600">Recommended order</p>
        <h2 id="analysis-route-heading" class="section-title mt-1">
          Theory → sample data → survey upload → synthesis
        </h2>
      </div>
      <p class="max-w-md text-sm text-muted">
        Opened status is stored only in this browser and is not a completion score.
      </p>
    </div>

    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        analysisRoute.map((item, index) => (
          <li class="relative">
            <article
              class:list={[
                'flex h-full flex-col rounded-2xl border p-5 shadow-sm',
                index === 0
                  ? 'border-tide-600/40 bg-tide-50'
                  : 'border-tide-900/10 bg-white',
              ]}
              data-analysis-card
              data-analysis-id={item.id}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="font-display text-3xl font-semibold text-tide-300" aria-hidden="true">
                  {item.number}
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted" aria-live="polite">
                  <span
                    class:list={[
                      'h-2 w-2 rounded-full',
                      index === 0 ? 'bg-kelp' : 'bg-tide-300',
                    ]}
                    aria-hidden="true"
                  />
                  <span data-analysis-status>{item.initialStatus}</span>
                </span>
              </div>
              <p class="mt-2 text-xs font-bold uppercase tracking-[0.12em] text-tide-600">
                {item.effort}
              </p>
              <h3 class="mt-1 font-display text-xl font-semibold text-tide-950">
                <a
                  class="text-tide-950 no-underline hover:text-tide-700 hover:underline"
                  href={hrefFor(item.href)}
                  aria-current={index === 0 ? 'page' : undefined}
                  data-analysis-link
                  data-analysis-id={item.id}
                >
                  {item.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/80">{item.description}</p>
              <a
                class="mt-4 text-sm font-semibold"
                href={hrefFor(item.href)}
                data-analysis-link
                data-analysis-id={item.id}
              >
                {item.action} <span aria-hidden="true">→</span>
              </a>
            </article>
            {
              index < analysisRoute.length - 1 && (
                <span class="absolute -right-3 top-1/2 z-10 hidden -translate-y-1/2 rounded-full bg-sand-50 px-1 text-tide-400 lg:block" aria-hidden="true">
                  →
                </span>
              )
            }
          </li>
        ))
      }
    </ol>
  </section>

  <section id="theory" class="mt-14 scroll-mt-28" aria-labelledby="theory-heading">
    <div class="mb-6">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-tide-600">
        Analysis route · 01
      </p>
      <h2 id="theory-heading" class="section-title mt-1">Background theory</h2>
      <p class="mt-2 max-w-3xl text-base text-muted md:text-lg">
        Work through three short notes. The final action takes you directly to the Tai Tam sample
        dataset.
      </p>
    </div>
    <Stepper
      client:load
      steps={steps}
      storageKey="vrssu-stepper-theory"
      nextHref={hrefFor('/students/samplingEffortTaiTam')}
      nextLabel="Continue to sample data"
    />

    <div class="mt-8">
      <SelfCheck
        client:load
        id="sd-se-check"
        legend="Which statement correctly interprets standard deviation (SD) and standard error (SE)?"
        options={spreadAndPrecisionOptions}
      />
    </div>
  </section>

  <aside class="mt-10 rounded-2xl border border-tide-900/10 bg-tide-950 p-6 text-white md:flex md:items-center md:justify-between md:gap-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-tide-200">Next recommended stop</p>
      <h2 class="mt-1 font-display text-2xl font-semibold">Practise before using your own survey</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/75">
        The sample dataset lets you learn the controls and compare species before checking a
        spreadsheet that may contain field or formatting issues.
      </p>
    </div>
    <a
      class="mt-5 inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-white/25 bg-white px-5 py-2.5 font-semibold text-tide-950 no-underline shadow-sm transition hover:-translate-y-0.5 hover:bg-tide-50 hover:text-tide-950 hover:no-underline md:mt-0"
      href={hrefFor('/students/samplingEffortTaiTam')}
      data-analysis-link
      data-analysis-id="sample"
    >
      Explore Tai Tam sample data
      <span aria-hidden="true">→</span>
    </a>
  </aside>

  <script>
    const journeyProgressKey = 'vrssu-journey-opened-v1';
    const analysisProgressKey = 'vrssu-analysis-opened-v1';

    type OpenedProgress = { opened: string[]; last?: string };

    function readProgress(key: string): OpenedProgress {
      try {
        const saved = JSON.parse(localStorage.getItem(key) || '{}') as OpenedProgress;
        return {
          opened: Array.isArray(saved.opened) ? saved.opened : [],
          last: typeof saved.last === 'string' ? saved.last : undefined,
        };
      } catch {
        return { opened: [] };
      }
    }

    function writeProgress(key: string, progress: OpenedProgress) {
      try {
        localStorage.setItem(key, JSON.stringify(progress));
      } catch {
        // The route remains fully usable when browser storage is unavailable.
      }
    }

    function markOpened(key: string, id: string) {
      const progress = readProgress(key);
      if (!progress.opened.includes(id)) progress.opened.push(id);
      progress.last = id;
      writeProgress(key, progress);
    }

    function renderAnalysisProgress() {
      const progress = readProgress(analysisProgressKey);
      document.querySelectorAll<HTMLElement>('[data-analysis-card]').forEach((card) => {
        const id = card.dataset.analysisId || '';
        if (id === 'theory' || !progress.opened.includes(id)) return;
        const status = card.querySelector<HTMLElement>('[data-analysis-status]');
        const dot = status?.previousElementSibling;
        if (status) status.textContent = 'Opened';
        dot?.classList.remove('bg-tide-300');
        dot?.classList.add('bg-kelp');
      });
    }

    document.querySelectorAll<HTMLElement>('[data-analysis-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.analysisId;
        if (id) markOpened(analysisProgressKey, id);
      });
    });

    markOpened(journeyProgressKey, 'after');
    markOpened(analysisProgressKey, 'theory');
    renderAnalysisProgress();
  </script>
</StudentsLayout>
